#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * StockFlow CLI.  Dùng:  bin/stockflow <lệnh>
 */
require __DIR__ . '/../src/bootstrap.php';

use StockFlow\Core\Config;
use StockFlow\Core\Db;
use StockFlow\Core\Migrator;
use StockFlow\Core\SchemaSync;

const USAGE = <<<TXT
Cách dùng: bin/stockflow <lệnh>
  update      CẬP NHẬT sau khi git pull / máy mới: tự cấu hình MySQL (XAMPP), tạo/sửa database cho đúng chuẩn, nạp dữ liệu mẫu nếu database trống,
              và bật tự cập nhật sau mỗi lần `git pull`
  db-config   nhập thông tin MySQL → .local/db.json (chmod 600)
  check       kiểm tra kết nối + phiên bản MySQL
  db-sync     KIỂM TRA database trên máy có đúng chuẩn dự án không, sai thì TỰ SỬA (sao lưu → dựng lại → nạp lại dữ liệu)
              --check chỉ báo cáo, không sửa · tự tạo database nếu chưa có
  migrate     tạo/cập nhật bảng (chạy lại an toàn)
  seed        nạp dữ liệu mẫu (3 kho, 30 mặt hàng, ≥200 dòng phát sinh); bỏ qua nếu đã có dữ liệu
  setup       db-sync + seed (như update nhưng không đụng cấu hình / git hook)
  serve       chạy web tại http://127.0.0.1:8080  (PORT=9000 để đổi cổng)
  test        chạy toàn bộ kiểm thử (cần CSDL cho integration/http)

TXT;

function connect(): Db
{
    return Db::connect(Config::database());
}

function cmdCheck(): int
{
    try {
        $db = connect();
        if ($db->isSqlite()) {
            echo '✔ SQLite ' . $db->value('SELECT sqlite_version()') . " (chế độ demo)\n";
            return 0;
        }
        $v = $db->one('SELECT DATABASE() AS db, CURRENT_USER() AS u, VERSION() AS v');
        $maria = stripos($v['v'], 'mariadb') !== false;
        if ($maria ? version_compare((string)preg_replace('/-.*/', '', $v['v']), '10.4', '<') : version_compare($v['v'], '8.0.16', '<')) {
            throw new RuntimeException('Cần MySQL >= 8.0.16 hoặc MariaDB >= 10.4 (XAMPP), hiện là ' . $v['v']);
        }
        echo "✔ CSDL={$v['db']} · USER={$v['u']} · MySQL {$v['v']}\n";
        return 0;
    } catch (Throwable $e) {
        fwrite(STDERR, '✘ ' . Db::explain($e) . "\n  Chạy bin/stockflow db-config (hoặc đặt DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS).\n");
        return 2;
    }
}

function cmdMigrate(): int
{
    foreach ((new Migrator(connect()))->migrate() as $line) {
        echo $line, "\n";
    }
    return 0;
}

function cmdDbSync(array $argv): int
{
    $config = Config::database();
    if (($config['driver'] ?? 'mysql') === 'sqlite') {
        echo "Chế độ demo (SQLite) luôn được dựng đúng chuẩn khi chạy `bin/stockflow demo` — không cần db-sync.
";
        return 0;
    }
    if (SchemaSync::ensureDatabase($config)) {
        echo "✔ Đã tạo database `{$config['database']}` (chưa có trên máy này).
";
    }
    $apply = !in_array('--check', $argv, true);
    $log = (new SchemaSync(connect(), $config))->run($apply);
    echo implode("
", $log), "
";
    return str_starts_with(end($log), '✔') ? 0 : 1;
}

function cmdSeed(array $argv): int
{
    require __DIR__ . '/../database/seeds/DemoSeed.php';
    $rc = \StockFlow\Seeds\DemoSeed::run(connect(), in_array('--force', $argv, true));
    if ($n = \StockFlow\Seeds\DemoSeed::backfillBarcodes(connect())) {   // CSDL demo có từ trước khi có mã vạch
        echo "✔ Đã gán mã vạch mẫu cho $n mặt hàng demo chưa có mã
";
    }
    return $rc;
}

/** Thông tin kết nối mặc định của XAMPP: root, không mật khẩu. Máy nào khác thì chạy `bin/stockflow db-config`. */
function ensureDefaultConfig(): void
{
    $path = Config::root() . '/.local/db.json';
    if (getenv('DB_HOST') !== false || is_file($path)) {
        return;
    }
    $old = umask(0077);
    @mkdir(dirname($path), 0700, true);
    file_put_contents($path, json_encode(['host' => '127.0.0.1', 'port' => '3306', 'database' => 'stockflow', 'user' => 'root', 'password' => ''], JSON_PRETTY_PRINT));
    umask($old);
    echo "✔ Chưa có cấu hình nên dùng mặc định của XAMPP (root, không mật khẩu, database `stockflow`) → .local/db.json\n";
}

/** Bật hook .githooks/post-merge: sau mỗi `git pull` tự chạy db-sync để database khớp mã nguồn mới. */
function installGitHook(): void
{
    $root = Config::root();
    if (!is_dir("$root/.git") || !is_file("$root/.githooks/post-merge")) {
        return;
    }
    @chmod("$root/.githooks/post-merge", 0755);
    exec('git -C ' . escapeshellarg($root) . ' config core.hooksPath .githooks', $out, $rc);
    echo $rc === 0
        ? "✔ Đã bật tự cập nhật database sau mỗi lần `git pull` (.githooks/post-merge)\n"
        : "⚠ Không bật được git hook — sau mỗi lần pull hãy chạy: php bin/stockflow update\n";
}

/** Một lệnh cho mọi máy: cấu hình → database đúng chuẩn (sao lưu trước khi sửa) → dữ liệu mẫu nếu trống → git hook. */
function cmdUpdate(array $argv): int
{
    ensureDefaultConfig();
    $config = Config::database();
    if (($config['driver'] ?? 'mysql') === 'sqlite') {
        fwrite(STDERR, "✘ Dự án dùng MySQL (XAMPP). Bỏ biến môi trường STOCKFLOW_SQLITE rồi chạy lại.\n");
        return 2;
    }
    $rc = cmdDbSync($argv);
    if ($rc !== 0) {
        return $rc;
    }
    if ((int)connect()->value('SELECT COUNT(*) FROM kho') === 0) {
        echo "→ Database trống: nạp dữ liệu mẫu.\n";
        $rc = cmdSeed($argv);
        if ($rc !== 0) {
            return $rc;
        }
    }
    installGitHook();
    echo "✔ Xong. Chạy web: php bin/stockflow serve  →  http://127.0.0.1:8080\n";
    return 0;
}

/**
 * Trước khi chạy web: tự đồng bộ cấu trúc CSDL MySQL với mã nguồn (sau khi `git pull` có đổi database/migrations thì chỉ việc chạy `serve`).
 * Dữ liệu cũ được sao lưu rồi nạp lại; lỗi đồng bộ chỉ cảnh báo, không chặn chạy web.
 */
function autoSyncDatabase(): void
{
    try {
        $config = Config::database();
        if (($config['driver'] ?? 'mysql') === 'sqlite') {
            return;
        }
        SchemaSync::ensureDatabase($config);
        $log = (new SchemaSync(connect(), $config))->run(true);
        if (!str_starts_with($log[0], '✔ CSDL')) {   // chỉ in khi có thay đổi
            echo implode("\n", $log), "\n";
        }
    } catch (Throwable $e) {
        fwrite(STDERR, '⚠ Không tự đồng bộ được CSDL: ' . Db::explain($e) . "\n  Thử chạy: bin/stockflow db-sync\n");
    }
}

function cmdServe(): int
{
    $port = getenv('PORT') ?: '8080';
    $root = Config::root();
    autoSyncDatabase();
    @mkdir("$root/.local/sessions", 0700, true);
    echo "▶ StockFlow tại http://127.0.0.1:$port  (Ctrl+C để dừng)\n";
    passthru(sprintf('php -d session.save_path=%s -S 127.0.0.1:%s -t %s %s',
        escapeshellarg("$root/.local/sessions"), escapeshellarg($port), escapeshellarg("$root/public"), escapeshellarg("$root/public/index.php")), $rc);
    return $rc;
}

function cmdDbConfig(): int
{
    $ask = function (string $label, string $default): string {
        echo "$label [$default]: ";
        $v = trim((string)fgets(STDIN));
        return $v === '' ? $default : $v;
    };
    $c = ['host' => $ask('Máy chủ MySQL', '127.0.0.1'), 'port' => $ask('Cổng', '3306'),
          'database' => $ask('Tên CSDL', 'stockflow'), 'user' => $ask('Tài khoản', 'stockflow')];
    if (!stream_isatty(STDIN)) {
        fwrite(STDERR, "Hãy chạy trong terminal tương tác để nhập mật khẩu (hoặc dùng biến môi trường DB_*).\n");
        return 2;
    }
    exec('stty -echo');
    try {
        echo 'Mật khẩu (không hiển thị): ';
        $c['password'] = rtrim((string)fgets(STDIN), "\r\n");
    } finally {
        exec('stty echo');
        echo "\n";
    }
    try {
        Db::connect($c);
    } catch (Throwable $e) {
        fwrite(STDERR, '✘ Không kết nối được: ' . Db::explain($e) . "\n");
        return 2;
    }
    $dir = Config::root() . '/.local';
    $old = umask(0077);
    @mkdir($dir, 0700, true);
    file_put_contents("$dir/db.json", json_encode($c, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
    chmod("$dir/db.json", 0600);
    umask($old);
    echo "✔ Đã lưu .local/db.json (chỉ trên máy này, đã nằm trong .gitignore)\n";
    return 0;
}

$cmd = $argv[1] ?? 'help';
try {
    exit(match ($cmd) {
        'db-config' => cmdDbConfig(),
        'check' => cmdCheck(),
        'migrate' => cmdMigrate(),
        'seed' => cmdSeed($argv),
        'db-sync' => cmdDbSync($argv),
        'setup' => cmdDbSync($argv) ?: cmdSeed($argv),
        'update' => cmdUpdate($argv),
        'serve' => cmdServe(),
        'test' => (function () { passthru('php ' . escapeshellarg(Config::root() . '/tests/run.php'), $rc); return $rc; })(),
        default => (function () { echo USAGE; return 0; })(),
    });
} catch (Throwable $e) {
    fwrite(STDERR, '✘ ' . Db::explain($e) . "\n");
    exit(1);
}
